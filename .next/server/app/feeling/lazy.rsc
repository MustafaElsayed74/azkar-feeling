0:["jzjP6vWxS9vrwKOM5dSsP",[[["",{"children":["feeling",{"children":[["slug","lazy","d"],{"children":["__PAGE__?{\"slug\":\"lazy\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["feeling",{"children":[["slug","lazy","d"],{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"flex flex-col min-h-screen dir-rtl bg-[#0b1329]","children":[["$","$L2",null,{}],["$","main",null,{"className":"flex-1 max-w-4xl w-full mx-auto px-4 py-6 sm:py-8","children":[["$","$L3",null,{"href":"/","className":"inline-flex items-center gap-1.5 text-xs font-semibold text-slate-400 hover:text-emerald-400 transition-colors mb-4","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}],["$","span",null,{"children":"الرجوع لجميع المشاعر"}]]}],["$","div",null,{"className":"clean-card p-5 sm:p-6 mb-6 flex items-center justify-between gap-4","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","div",null,{"className":"w-12 h-12 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-2xl shrink-0","children":"🔋"}],["$","div",null,{"children":[["$","span",null,{"className":"text-[11px] font-medium text-emerald-400 block","children":"أدعية وأذكار عند"}],["$","h1",null,{"className":"text-xl sm:text-2xl font-bold text-white mt-0.5","children":"كسلان وعاجز"}]]}]]}],["$","span",null,{"className":"text-xs font-semibold px-3 py-1 rounded-lg bg-slate-900 border border-slate-800 text-slate-300","children":[4," ","أدعية"]}]]}],["$","$L4",null,{"group":{"feeling":"Lazy","slug":"lazy","url":"https://allahuakbarofficial.com/lazy/","items_count":4,"duas":[{"title":"Protect Yourself From Anxiety, Laziness & Debt","arabic":"اَللّٰهُمَّ إِنِّيْ أَعُوْذُ بِكَ مِنَ الْهَمِّ وَالْحَزَنِ ، وَأَعُوْذُ بِكَ مِنَ الْعَجْزِ وَالْكَسَلِ، وَأَعُوْذُ بِكَ مِنَ الْجُبْنِ وَالْبُخْلِ ، وَأَعُوْذُ بِكَ مِنْ غَلَبَةِ الدَّيْنِ وَقَهْرِ الرِّجَالِ.","transliteration":"Allāhumma innī aʿūdhu bika min-l-hammi wa-l-ḥazan, wa aʿūdhu bika min-l-ʿajzi wa-l-kasal, wa aʿūdhu bika min-l-jubni wa-l-bukhl, wa aʿūdhu bika min ghalabati-d-dayni wa qahri-r-rijāl.","translation":"O Allah, I seek Your protection from anxiety and grief. I seek Your protection from inability and laziness. I seek Your protection from cowardice and miserliness, and I seek Your protection from being overcome by debt and being overpowered by men.","description":null,"benefit":null,"virtue":"Abū Saʿīd al-Khudrī (raḍiy Allāhu ʿanhu) narrated that one day, the Messenger of Allah ﷺ entered the masjid. He saw a man from the Anṣār called Abū Umāmah (raḍiy Allāhu ʿanhu). He ﷺ asked, “What is the matter? Why are you sitting in the masjid when it is not the time for prayer?” He replied, “Never-ending worries and debts, O Messenger of Allah.” The Messenger of Allah ﷺ then asked, “Shall I not teach you words by which, when you say them, Allah will remove your worries, and settle your debts?” He replied, “Yes of course, O Messenger of Allah.” He ﷺ said, “Say in the morning and evening [the above].” Abū Umāmah (raḍiy Allāhu ʿanhu) said, “Then I did that, and Allah removed my worries and settled my debts.” (Abū Dāwūd 1555)","hadith":null,"reference":"عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ، قَالَ: دَخَلَ رَسُولُ صَلَّى عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ الْمَسْجِدَ، فَإِذَا هُوَ بِرَجُلٍ مِنَ الْأَنْصَارِ، يُقَالُ لَهُ: أَبُو أُمَامَةَ، فَقَالَ: «يَا أُمَامَةَ، مَا لِي أَرَاكَ جَالِسًا فِي الْمَسْجِدِ فِي غَيْرِ وَقْتِ الصَّلَاةِ؟»، قَالَ: هُمُومٌ لَزِمَتْنِي، وَدُيُونٌ يَا رَسُولَ اللَّهِ، قَالَ: أَفَلَا أُعَلِّمُكَ كَلَامًا إِذَا أَنْتَ قُلْتَهُ أَذْهَبَ عز وجل هَمَّكَ، وَقَضَى عَنْكَ دَيْنَكَ؟، قَالَ: قُلْتُ: بَلَى، يَا رَسُولَ، قَالَ: ” قُلْ إِذَا أَصْبَحْتَ، وَإِذَا أَمْسَيْتَ: اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْهَمِّ وَالْحَزَنِ، وَأَعُوذُ بِكَ مِنَ الْعَجْزِ وَالْكَسَلِ، وَأَعُوذُ بِكَ مِنَ الْجُبْنِ وَالْبُخْلِ، وَأَعُوذُ بِكَ مِنْ غَلَبَةِ الدَّيْنِ، وَقَهْرِ الرِّجَالِ “، قَالَ: فَفَعَلْتُ ذَلِكَ، فَأَذْهَبَ اللَّهُ عز وجل هَمِّي، وَقَضَى عَنِّي دَيْنِي.\n(سنن أبي داود ١٥٥٥)","source":"Allahu Akbar Official","quran_reference":null,"surah":null,"ayah":null,"narrator":null,"repeat_count":null,"audio_url":null,"image_url":null,"source_url":"https://allahuakbarofficial.com/lazy/"},{"title":"Ask Allah for Good Health and Protection","arabic":"اَللّٰهُمَّ عَافِنِيْ فِيْ بَدَنِيْ ، اَللّٰهُمَّ عَافِنِيْ فِيْ سَمْعِيْ ، اَللّٰهُمَّ عَافِنِيْ فِيْ بَصَرِيْ ، لَا إِلٰهَ إِلَّا أَنْتَ ، اَللّٰهُمَّ إِنِّيْ أَعُوْذُ بِكَ مِنَ الْكُفْرِ وَالْفَقْرِ، وأَعُوْذُ بِكَ مِنْ عَذَابِ الْقَبْرِ، لَا إِلٰهَ إِلَّا أَنْتَ.\nعن جعفر بنِ ميمون ، حدَّثني عبدُ الرحمن بنُ أبي بكرَة، أنه قال لأبيه: يا أبةِ إني أَسمَعُكَ تَدْعُو كلَّ غَدَاةٍ: اللَّهُمَّ عافِني في بَدَني، اللهم عافِنِي في سَمْعِي، اللَّهُمَّ عافني في بَصَري، لا إلهَ إلا أنت، تُعيدها ثلاثاً حينَ تُصْبِحُ، وثلاثاً حينَ تُمسي، فقال: إني سمعتُ رسولَ الله صلى الله عليه وسلم -يدعو بهنَّ فانا أُحِبُّ أن أستَنَّ بسُنَّتِه، وقال عليٌّ وعباسٌ فيه: ويقول: اللهُمَّ إني أعوذُ بِكَ من الكُفر والفَقرِ، اللَّهُمَ إني أعُوذُ بِكَ مِن عذابِ القبر، لا إلهَ إلا أنتَ، يُعيدها ثلاثاً حِين يُصبحُ، وثلاثاً حين يُمسي، فيَدعُو بهِنَّ، فاُحِبُّ أن أستَنَّ بسُنتَّه.\nحَدَّثَنَا أَبُو عَامِرٍ، حَدَّثَنَا عَبْدُ الْجَلِيلِ، حَدَّثَنِي جَعْفَرُ بْنُ مَيْمُونٍ، حَدَّثَنِي عَبْدُ الرَّحْمَنِ بْنُ أَبِي بَكَرَةَ أَنَّهُ قَالَ لِأَبِيهِ:","transliteration":"Allāhumma ʿāfinī fī badanī, Allāhumma ʿāfinī fī samʿī, Allāhumma ʿāfinī fī baṣarī, lā ilāha illā Ant, Allāhumma innī aʿūdhu bika mina-l-kufri wa-l-faqr, wa aʿūdhu bika min ʿadhābi-l-qabr, lā ilāha illā Ant.","translation":"Repeat. x3","description":null,"benefit":null,"virtue":null,"hadith":"‘Abd al-Raḥmān b. Abī Bakrah (raḍiy Allāhu ʿanhu) narrates that he said to his father, “O my father! I hear you supplicating with [the above] every morning. You repeat them three times in the morning and three times in the evening.” He said, “Indeed I heard the Messenger of Allah ﷺ supplicating with these (words) and I love to follow his practice.” (Abū Dāwūd 5090, Aḥmad 20430)","reference":"(سنن أبي داود ٥٠٩٠)\nيَا أَبَهْ، إِنِّي أَسْمَعُك تَدْعُو كُلَّ غَدَاةٍ: ” اللهُمَّ عَافِنِي فِي بَدَنِي، اللهُمَّ عَافِنِي فِي سَمْعِي، اللهُمَّ عَافِنِي فِي بَصَرِي، لَا إِلَهَ إِلَّا أَنْتَ ” تُعِيدُهَا ثَلَاثًا حِينَ تُصْبِحُ، وَثَلَاثًا حِينَ تُمْسِي. وَتَقُولُ: ” اللهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْكُفْرِ وَالْفَقْرِ، اللهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ، لَا إِلَهَ إِلَّا أَنْتَ ” تُعِيدُهَا حِينَ تُصْبِحُ ثَلَاثًا، وَثَلَاثًا حِينَ تُمْسِي. قَالَ: نَعَمْ يَا بُنَيَّ، إِنِّي سَمِعْتُ النَّبِيَّ صلى الله عليه وسلم يَدْعُو بِهِنَّ، فَأُحِبُّ أَنْ أَسْتَنَّ بِسُنَّتِهِ. (مسند أحمد ٢٠٤٣٠)","source":"Allahu Akbar Official","quran_reference":null,"surah":null,"ayah":null,"narrator":"He said","repeat_count":3,"audio_url":null,"image_url":null,"source_url":"https://allahuakbarofficial.com/lazy/"},{"title":"Entrust All Your Matters to Allah","arabic":"يَا حَيُّ يَا قَيُّوْمُ ، بِرَحْمَتِكَ أَسْتَغِيْثُ ، أَصْلِحْ لِيْ شَأْنِيْ كُلَّهُ ، وَلَا تَكِلْنِيْ إِلَىٰ نَفْسِيْ طَرْفَةَ عَيْنٍ.\nأخبرنَا عبد الرَّحْمَن بن مُحَمَّد بن سَلام حَدثنَا زيد بن الْحباب أَخْبرنِي عُثْمَان بن موهب الْهَاشِمِي سَمِعت أنس بن مَالك يَقُول قَالَ النَّبِي صلى الله عليه وسلم لفاطمة مَا يمنعك أَن سَمْعِي مَا أوصيك بِهِ أَو تقولي إِذا أَصبَحت وَإِذا أمسيت يَا حَيّ يَا قيوم بِرَحْمَتك أستغيث أصلح لي شأني كلَّه وَلَا تَكِلنِي إِلَى نَفسِي طرفَة عين.","transliteration":"Yā Ḥayyu yā Qayyūm, bi-raḥmatika astaghīth, aṣliḥ lī sha’nī kullah, wa lā takilnī ilā nafsī ṭarfata ʿayn.","translation":"O The Ever Living, The Sustainer of all. ; I seek assistance through Your mercy. Rectify all of my affairs and do not entrust me to myself for the blink of an eye.","description":null,"benefit":null,"virtue":null,"hadith":"Anas b. Mālik (raḍiy Allāhu ʿanhu) narrates that the Prophet ﷺ said to Fāṭimah (raḍiy Allāhu ʿanhā), “What is preventing you from (doing) what I am advising you; that you say [the above] in the morning and evening?” (Nasā’ī in ʿAmal al-Yawm wa-l-Laylah 570)","reference":"(عمل اليوم والليلة للنسائي ٥٧٠)","source":"Allahu Akbar Official","quran_reference":null,"surah":null,"ayah":null,"narrator":null,"repeat_count":null,"audio_url":null,"image_url":null,"source_url":"https://allahuakbarofficial.com/lazy/"},{"title":"Protection from Evil Traits & Endings","arabic":"اَللّٰهُمَّ إِنّيْ أَعُوْذُ بِكَ مِنَ الْبُخْلِ ، وَأَعُوْذُ بِكَ مِنَ الْجُبْنِ ، وَأَعُوْذُ بِكَ أَنْ أُرَدَّ إِلَىٰ أَرْذَلِ الْعُمُرِ ، وَأَعُوْذُ بِكَ مِنْ فِتْنَةِ الدُّنْيَا ، وَأَعُوْذُ بِكَ مِنْ عَذَابِ الْقَبْرِ.","transliteration":"Allāhumma innī aʿūdhu bika mina-l-bukhl, wa aʿūdhu bika mina-l-jubn, wa aʿūdhu bika an uradda ilā ardhali-l-ʿumur, wa aʿūdhu bika min fitnati-d-dunyā, wa aʿūdhu bika min ʿadhābi-l-qabr.","translation":"O Allah, I seek Your protection from miserliness and I seek Your protection from cowardice. I seek Your protection from being returned to the worst part of life (old age), I seek Your protection from the trials of the world, and I seek Your protection from the punishment of the grave.","description":null,"benefit":null,"virtue":null,"hadith":"Saʿd b. Abī Waqqās (radiy Allāhū ‘anhu) would instruct (to seek refuge) about five things [the above] and he would narrate it from the Messenger of Allah ﷺ . (Bukhārī 6370)","reference":"عَنْ سَعْدِ بْنِ أَبِي وَقَّاصٍ رضي الله عنه كَانَ يَأْمُرُ بِهَؤُلَاءِ الْخَمْسِ وَيُحَدِّثُهُنَّ عَنِ النَّبِيِّ صلى الله عليه وسلم: اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْبُخْلِ، وَأَعُوذُ بِكَ مِنَ الْجُبْنِ، وَأَعُوذُ بِكَ أَنْ أُرَدَّ إِلَى أَرْذَلِ الْعُمُرِ، وَأَعُوذُ بِكَ مِنْ فِتْنَةِ الدُّنْيَا، وَأَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ. (صحيح البخاري ٦٣٧٠)","source":"Allahu Akbar Official"