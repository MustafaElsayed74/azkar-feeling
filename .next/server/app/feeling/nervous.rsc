0:["jzjP6vWxS9vrwKOM5dSsP",[[["",{"children":["feeling",{"children":[["slug","nervous","d"],{"children":["__PAGE__?{\"slug\":\"nervous\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["feeling",{"children":[["slug","nervous","d"],{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"flex flex-col min-h-screen dir-rtl bg-[#0b1329]","children":[["$","$L2",null,{}],["$","main",null,{"className":"flex-1 max-w-4xl w-full mx-auto px-4 py-6 sm:py-8","children":[["$","$L3",null,{"href":"/","className":"inline-flex items-center gap-1.5 text-xs font-semibold text-slate-400 hover:text-emerald-400 transition-colors mb-4","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}],["$","span",null,{"children":"الرجوع لجميع المشاعر"}]]}],["$","div",null,{"className":"clean-card p-5 sm:p-6 mb-6 flex items-center justify-between gap-4","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","div",null,{"className":"w-12 h-12 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-2xl shrink-0","children":"💓"}],["$","div",null,{"children":[["$","span",null,{"className":"text-[11px] font-medium text-emerald-400 block","children":"أدعية وأذكار عند"}],["$","h1",null,{"className":"text-xl sm:text-2xl font-bold text-white mt-0.5","children":"متوتر"}]]}]]}],["$","span",null,{"className":"text-xs font-semibold px-3 py-1 rounded-lg bg-slate-900 border border-slate-800 text-slate-300","children":[7," ","أدعية"]}]]}],["$","$L4",null,{"group":{"feeling":"Nervous","slug":"nervous","url":"https://allahuakbarofficial.com/nervous/","items_count":7,"duas":[{"title":"Protect Yourself From Anxiety, Laziness & Debt","arabic":"اَللّٰهُمَّ إِنِّيْ أَعُوْذُ بِكَ مِنَ الْهَمِّ وَالْحَزَنِ ، وَأَعُوْذُ بِكَ مِنَ الْعَجْزِ وَالْكَسَلِ، وَأَعُوْذُ بِكَ مِنَ الْجُبْنِ وَالْبُخْلِ ، وَأَعُوْذُ بِكَ مِنْ غَلَبَةِ الدَّيْنِ وَقَهْرِ الرِّجَالِ.","transliteration":"Allāhumma innī aʿūdhu bika min-l-hammi wa-l-ḥazan, wa aʿūdhu bika min-l-ʿajzi wa-l-kasal, wa aʿūdhu bika min-l-jubni wa-l-bukhl, wa aʿūdhu bika min ghalabati-d-dayni wa qahri-r-rijāl.","translation":"O Allah, I seek Your protection from anxiety and grief. I seek Your protection from inability and laziness. I seek Your protection from cowardice and miserliness, and I seek Your protection from being overcome by debt and being overpowered by men.","description":null,"benefit":null,"virtue":"Abū Saʿīd al-Khudrī (raḍiy Allāhu ʿanhu) narrated that one day, the Messenger of Allah ﷺ entered the masjid. He saw a man from the Anṣār called Abū Umāmah (raḍiy Allāhu ʿanhu). He ﷺ asked, “What is the matter? Why are you sitting in the masjid when it is not the time for prayer?” He replied, “Never-ending worries and debts, O Messenger of Allah.” The Messenger of Allah ﷺ then asked, “Shall I not teach you words by which, when you say them, Allah will remove your worries, and settle your debts?” He replied, “Yes of course, O Messenger of Allah.” He ﷺ said, “Say in the morning and evening [the above].” Abū Umāmah (raḍiy Allāhu ʿanhu) said, “Then I did that, and Allah removed my worries and settled my debts.” (Abū Dāwūd 1555)","hadith":null,"reference":"عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ، قَالَ: دَخَلَ رَسُولُ صَلَّى عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ الْمَسْجِدَ، فَإِذَا هُوَ بِرَجُلٍ مِنَ الْأَنْصَارِ، يُقَالُ لَهُ: أَبُو أُمَامَةَ، فَقَالَ: «يَا أُمَامَةَ، مَا لِي أَرَاكَ جَالِسًا فِي الْمَسْجِدِ فِي غَيْرِ وَقْتِ الصَّلَاةِ؟»، قَالَ: هُمُومٌ لَزِمَتْنِي، وَدُيُونٌ يَا رَسُولَ اللَّهِ، قَالَ: أَفَلَا أُعَلِّمُكَ كَلَامًا إِذَا أَنْتَ قُلْتَهُ أَذْهَبَ عز وجل هَمَّكَ، وَقَضَى عَنْكَ دَيْنَكَ؟، قَالَ: قُلْتُ: بَلَى، يَا رَسُولَ، قَالَ: ” قُلْ إِذَا أَصْبَحْتَ، وَإِذَا أَمْسَيْتَ: اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْهَمِّ وَالْحَزَنِ، وَأَعُوذُ بِكَ مِنَ الْعَجْزِ وَالْكَسَلِ، وَأَعُوذُ بِكَ مِنَ الْجُبْنِ وَالْبُخْلِ، وَأَعُوذُ بِكَ مِنْ غَلَبَةِ الدَّيْنِ، وَقَهْرِ الرِّجَالِ “، قَالَ: فَفَعَلْتُ ذَلِكَ، فَأَذْهَبَ اللَّهُ عز وجل هَمِّي، وَقَضَى عَنِّي دَيْنِي.(سنن أبي داود ١٥٥٥)","source":"Allahu Akbar Official","quran_reference":null,"surah":null,"ayah":null,"narrator":null,"repeat_count":null,"audio_url":null,"image_url":null,"source_url":"https://allahuakbarofficial.com/nervous/"},{"title":"Attain Well-being in This World and the Hereafter","arabic":"اَللّٰهُمَّ إِنِّيْ أَسْأَلُكَ الْعَافِيَةَ فِي الدُّنْيَا وَالْآخِرَةِ ، اَللّٰهُمَّ إِنِّيْ أَسْأَلُكَ الْعَفْوَ وَالْعَافِيَةَ فِيْ دِيْنِيْ وَدُنْيَايَ وَأَهْلِيْ وَمَالِيْ ، اَللّٰهُمَّ اسْتُرْ عَوْرَاتِيْ وَآمِنْ رَّوْعَاتِيْ ، اَللّٰهُمَّ احْفَظْنِيْ مِنْ بَيْنِ يَدَيَّ ، وَمِنْ خَلْفِيْ ، وَعَنْ يَّمِيْنِيْ ، وَعَنْ شِمَالِيْ ، وَمِنْ فَوْقِيْ ، وَأَعُوْذُ بِعَظَمَتِكَ أَنْ أُغْتَالَ مِنْ تَحْتِيْ.","transliteration":"Allāhumma innī as’aluka-l-ʿāfiyata fi-d-dunyā wa-l-ākhirah. Allāhumma innī as’aluka-l-ʿafwa wa-l-ʿāfiyata fī dīnī wa dunyāya wa ahlī wa mālī, Allāhumma-stur ʿawrātī wa āmi-r-rawʿātī. Allāhumma-ḥfaẓnī mim bayni yadayya wa min khalfī, wa ʿay-yamīnī wa ʿan shimālī wa min fawqī, wa aʿūdhu bi-ʿaẓamatika an ughtāla min taḥtī.","translation":"O Allah, I ask You for well-being in this world and the next. O Allah, I ask You for forgiveness and well-being in my religion, in my worldly affairs, in my family and in my wealth. O Allah, conceal my faults and calm my fears. O Allah, guard me from in front of me and behind me, from my right, and from my left, and from above me. I seek protection in Your Greatness from being unexpectedly destroyed from beneath me.","description":null,"benefit":null,"virtue":"The Messenger of Allah ﷺ said: “Ask Allah for forgiveness and well-being (‘āfiyah). Indeed, after conviction (yaqīn), no one has been granted anything better than well-being.” (Tirmidhī)","hadith":"ʿAbdullāh b. ʿUmar (raḍiy Allāhu ʿanhumā) narrated: “The Messenger of Allah ﷺ never failed to say these words in the morning and in the evening.” (Abū Dāwūd 5074)","reference":"عَنْ جُبَيْرِ بْنِ أَبِي سُلَيْمَانَ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ، قَالَ: سَمِعْتُ ابْنَ عُمَرَ، يَقُولُ: لَمْ يَكُنْ رَسُولُ اللَّهِ صلى الله عليه وسلم يَدَعُ هَؤُلَاءِ الدَّعَوَاتِ، حِينَ يُمْسِي، وَحِينَ يُصْبِحُ: اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَافِيَةَ فِي الدُّنْيَا وَالْآخِرَةِ، اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَفْوَ وَالْعَافِيَةَ فِي دِينِي وَدُنْيَايَ وَأَهْلِي وَمَالِي، اللَّهُمَّ اسْتُرْ عَوْرَتِي، وَقَالَ عُثْمَانُ: عَوْرَاتِي وَآمِنْ رَوْعَاتِي، اللَّهُمَّ احْفَظْنِي مِنْ بَيْنِ يَدَيَّ، وَمِنْ خَلْفِي، وَعَنْ يَمِينِي، وَعَنْ شِمَالِي، وَمِنْ فَوْقِي، وَأَعُوذُ بِعَظَمَتِكَ أَنْ أُغْتَالَ مِنْ تَحْتِي.(سنن أبي داود ٥٠٧٤)","source":"Allahu Akbar Official","quran_reference":null,"surah":null,"ayah":null,"narrator":null,"repeat_count":null,"audio_url":null,"image_url":null,"source_url":"https://allahuakbarofficial.com/nervous/"},{"title":"Allah Will Suffice You in Everything","arabic":"حَسْبِيَ اللّٰهُ لَا إِلٰهَ إِلَّا هُوَ ، عَلَيْهِ تَوَكَّلْتُ ، وَهُوَ رَبُّ الْعَرْشِ الْعَظِيْمِ.","transliteration":"Ḥasbiya-Allāhu lā ilāha illā Huwa, ʿalayhi tawakkalt, wa Huwa Rabbu-l-ʿArshi-l-ʿaẓīm.","translation":"Repeat. x7","description":null,"benefit":null,"virtue":"Abū al-Dardā’ (raḍiy Allāhu ʿanhu) narrates from the Messenger of Allah ﷺ that he said: “Whoever recites [the above] seven times in the morning and in the evening, Allah will suffice him in everything that concerns him in matters of this world and the next.” (Ibn al-Sunnī 71)","hadith":null,"reference":"عَنْ أَبِي الدَّرْدَاءِ، رضي الله عنه، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ: مَنْ قَالَ فِي كُلِّ يَوْمٍ حِينَ يُصْبِحُ وَحِينَ يُمْسِي: حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ، عَلَيْهِ تَوَكَّلْتُ، وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ، سَبْعَ مَرَّاتٍ، كَفَاهُ اللَّهُ عز وجل هَمَّهُ مِنْ أَمْرِ الدُّنْيَا وَالْآخِرَةِ. (عمل اليوم والليلة لابن السني ٧١)","source":"Allahu Akbar Official","quran_reference":null,"surah":null,"ayah":null,"narrator":null,"repeat_count":7,"audio_url":null,"image_url":null,"source_url":"https://allahuakbarofficial.com/nervous/"},{"title":"When One Is Distressed","arabic":"اَللّٰهُمَّ رَحْمَتَكَ أَرْجُوْ فَلَا تَكِلْنِيْ إِلٰى نَفْسِيْ طَرْفَةَ عَيْنٍ ، وَأَصْلِحْ لِي شَأْنِيْ كُلَّهُ ، لَا إِلٰهَ إِلَّا أَنْتَ","transliteration":"Allāhumma raḥmataka arjū fa-lā takilnī ilā nafsī ṭarfata ʿayn, wa aṣliḥ lī sha’nī kullah, lā ilāha illā Ant.","translation":"O Allah! It is certainly Your Mercy what I hope for, so do not entrust me to myself for the blink of an eye; and rectify all of my affairs. There is no god worthy of worship except You.","description":null,"benefit":null,"virtue":null,"hadith":"The Messenger of Allah ﷺ said: “The supplications of the distressed person are [the above].” (Abū Dāwūd 5090)","reference":"عَنْ جَعْفَرِ بْنِ مَيْمُونٍ قَالَ: حَدَّثَنِي عَبْدُ الرَّحْمَنِ بْنُ أَبِي بَكْرَةَ «أَنَّهُ قَالَ لِأَبِيهِ : يَا أَبَتِ إِنِّي أَسْمَعُكَ تَدْعُو كُلَّ غَدَاةٍ: اللَّهُمَّ عَافِنِي فِي بَدَنِي، اللَّهُمَّ عَافِنِي فِي سَمْعِي، اللَّهُمَّ عَافِنِي فِي بَصَرِي، لَا إِلَهَ إِلَّا أَنْتَ، تُعِيدُهَا ثَلَاثًا حِينَ تُصْبِحُ، وَثَلَاثًا حِينَ تُمْسِي، فَقَالَ: إِنِّي سَمِعْتُ رَسُولَ اللهِ صلى الله عليه وسلم يَدْعُو بِهِنَّ، فَأَنَا أُحِبُّ أَنْ أَسْتَنَّ بِسُنَّتِهِ قَالَ عَبَّاسٌ فِيهِ: وَتَقُولُ اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْكُفْرِ وَالْفَقْرِ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ، لَا إِلَهَ إِلَّا أَنْتَ، تُعِيدُهَا ثَلَاثًا حِينَ تُصْبِحُ، وَثَلَاثًا حِينَ تُمْسِي، فَتَدْعُو بِهِنَّ، فَأُحِبُّ أَنْ أَسْتَنَّ بِسُنَّتِهِ. قَالَ: وَقَالَ رَسُولُ اللهِ صلى الله عليه وسلم: دَعَوَاتُ الْمَكْرُوبِ اللَّهُمَّ رَحْمَتَكَ أَرْجُو، فَلَا ‌تَكِلْنِي إِلَى نَفْسِي طَرْفَةَ عَيْنٍ، وَأَصْلِحْ لِي شَأْنِي كُلَّهُ، لَا إِلَهَ إِلَّا أَنْتَ. (سنن ابي داود ٥٠٩٠)","source":"Allahu Akbar Official","quran_reference":null,"surah":null,"ayah":null,"narrator":null,"repeat_count":null,"audio_url":null,"image_url":null,"source_url":"https://allahuakbarofficial.com/nervous/"},{"title":"Duʿa of Prophet Musa ﷺ for Inner Peace & Strength","arabic":"رَبِّ اشْرَحْ لِيْ صَدْرِيْ ، وَيَسِّرْ لِيْٓٓ أَمْرِيْْ.","transliteration":"Rabbi-sh-shraḥ lī ṣadrī. Wa yassir lī amrī.","translation":"My Lord, put my heart at peace for me, and make my task easy for me. (20:25-26)","description":null,"benefit":null,"virtue":null,"hadith":null,"reference":null,"source":"Allahu Akbar Official","quran_reference":null,"surah":null,"ayah":null,"narrator":null,"repeat_count":null,"audio_url":null,"image_url":null,"source_url":"https://allahuakbarofficial.com/nervous/"},{"title":"Entrust All Your Matters to Allah","arabic":"يَا حَيُّ يَا قَيُّوْمُ ، بِرَحْمَتِكَ أَسْتَغِيْثُ ، أَصْلِحْ لِيْ شَأْنِيْ كُلَّهُ ، وَلَا تَكِلْنِيْ إِلَىٰ نَفْسِيْ طَرْفَةَ عَيْنٍ.\nأخبرنَا عبد الرَّحْمَن بن مُحَمَّد بن سَلام حَدثنَا زيد بن الْحباب أَخْبرنِي عُثْمَان بن موهب الْهَاشِمِي سَمِعت أنس بن مَالك يَقُول قَالَ النَّبِي صلى الله عليه وسلم لفاطمة مَا يمنعك أَن سَمْعِي مَا أوصيك بِهِ أَو تقولي إِذا أَصبَحت وَإِذا أمسيت يَا حَيّ يَا قيوم بِرَحْمَتك أستغيث أصلح لي شأني كلَّه وَلَا تَكِلنِي إِلَى نَفسِي طرفَة عين.","transliteration":"Yā Ḥayyu yā Qayyūm, bi-raḥmatika astaghīth, aṣliḥ lī sha’nī kullah, wa lā takilnī ilā nafsī ṭarfata ʿayn.","translation":"O The Ever Living, The Sustainer of all. ; I seek assistance through Your mercy. Rectify all of my affairs and do not entrust me to myself for the blink of an eye.","description":null,"benefit":null,"virtue":null,"hadith":"Anas b. Mālik (raḍiy Allāhu ʿanhu) narrates that the Prophet ﷺ said to Fāṭimah (raḍiy Allāhu ʿanhā), “What is preventing you from (doing) what I am advising you; that you say [the above] in the morning and evening?” (Nasā’ī in ʿAmal al-Yawm wa-l-Laylah 570)","reference":"(عمل اليوم والليلة للنسائي ٥٧٠)","source":"Allahu Akbar Official","quran_reference":null,"surah":null,"ayah":null,"narrator":null,"repeat_count":null,"audio_url":null,"image_url":null,"source_url":"https://allahuakbarofficial.com/nervous/"},{"title":"Duʿa of Prophet Ayyub ﷺ for Times of Distress","arabic":"-رَبِّ- أَنِّيْ مَسَّنِيَ الضُّرُّ وَأَنْتَ أَرْحَمُ الرّٰحِمِيْن.","transliteration":"(Rabbi) Annī massaniya-ḍ-ḍurru wa Anta Arḥamu-r-raḥimīn.","translation":"(My Lord), indeed adversity has touched me, and you are the Most Merciful of the merciful. (21:83)","description":null,"benefit":null,"virtue":null,"hadith":null,"reference":null,"source":"Allahu Akbar Official","quran_reference":null,"surah":null,"ayah":null,"narrator":null,"repeat_count":null,"audio_url":null,"image_url":null,"source_url":"https://allahuakbarofficial.com/nervous/"}],"arabic_name":"متوتر"}}],["$","div",null,{"className":"flex items-center justify-between gap-4 mt-8 pt-4 border-t border-slate-800/60 text-xs","children":[["$","$L3",null,{"href":"/feeling/lonely","className":"flex items-center gap-1.5 px-3 py-2 rounded-xl clean-card text-slate-300 hover:text-white","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-3.5 h-3.5 text-emerald-400","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}],["$","span",null,{"children":"وحيد"}]]}],["$","$L3",null,{"href":"/feeling/regret","className":"flex items-center gap-1.5 px-3 py-2 rounded-xl clean-card text-slate-300 hover:text-white","children":[["$","span",null,{"children":"نادم"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left w-3.5 h-3.5 text-emerald-400","chil